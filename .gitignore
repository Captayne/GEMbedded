# pTOS has its own repository
pTOS/
# build output
*.o
*.elf
*.map
*.uf2
*.TOS
*.tos
*.PRG
*.prg
*.ACC
*.acc
board-test/build/
sdcard/

# diagnostics: screenshots, console dumps, logs
tools/*.png
tools/*.log
tools/consolelog.txt
tools/dump.txt

# vendor photos and drawings (Waveshare and shops): not ours to redistribute
# (anchored: Windows matches this without regard to case, and the Arduino
#  board package has a "hardware" folder of its own)
/Hardware/

# IRKernel licence files: per licensee, never per repository.  They carry a
# name and a licence id, and a repository is what gets cloned and passed on.
*.license
*.lic
irkernel.license

# camera roll dropped into the tree, and local copies of what is
# already versioned
WhatsApp*
*.jpeg
ffmpeg2pass-*

# fetched by tools/get-toolchain.py, not kept in the repository
arduino/toolchain/

__pycache__/
*.pyc
Emulators/
docs/*.pdf
